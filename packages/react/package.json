{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@svidskiy/glass-surface-react",
  "version": "1.0.0",
  "description": "Refractive liquid glass React component",
  "keywords": [
    "react",
    "glass",
    "liquid-glass",
    "glassmorphism",
    "backdrop-filter",
    "webgl"
  ],
  "homepage": "https://github.com/svidskiy/glass-surface/tree/main/packages/react#readme",
  "bugs": "https://github.com/svidskiy/glass-surface/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svidskiy/glass-surface.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "release": "bun publish",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@svidskiy/glass-surface": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
