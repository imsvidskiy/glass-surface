{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "@tsconfig/bases/strictest",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,

    "module": "preserve",

    "declaration": true,
    "noEmit": true,

    "verbatimModuleSyntax": true,
    "isolatedDeclarations": true,
    "erasableSyntaxOnly": true,

    "target": "es2023",
    "lib": ["es2023", "dom"],
    "moduleDetection": "force"
  }
}
