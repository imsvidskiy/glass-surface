{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/bases/strictest",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "module": "preserve",
    "noEmit": true,
    "target": "es2023",
    "noUncheckedIndexedAccess": false,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true
  }
}
