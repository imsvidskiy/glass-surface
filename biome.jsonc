{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react"
  ],
  "formatter": {
    "expand": "always",
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentArrowReturn": {
          "level": "error",
          "options": {
            "style": "always"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        ".github/PULL_REQUEST_TEMPLATE.md"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptySource": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/core/src/webgl/painter.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    }
  ]
}
