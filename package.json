{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "glass-surface-monorepo",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "playground"
    ],
    "catalog": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check && bun run --filter playground check",
    "deploy": "bun run --filter playground deploy",
    "dev": "bun run --filter playground dev",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "release": "bun run build && bun publish --recursive",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "version-packages": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.6.7",
    "@changesets/cli": "^3.0.3",
    "@tsconfig/bases": "^1.0.30",
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "ultracite": "^8.2.0"
  },
  "packageManager": "bun@1.4.4"
}
